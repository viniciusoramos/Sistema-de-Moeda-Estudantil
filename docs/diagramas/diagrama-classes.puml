@startuml diagrama-classes
' =====================================================================
' Sistema de Moeda Estudantil - PUC Minas
' Diagrama de Classes do domínio - v2 (Lab03S02)
'
' Corresponde ao pacote br.pucminas.moedaestudantil.model.
' Getters/setters triviais foram omitidos para legibilidade.
'
' Mudanças em relação à v1 (Lab03S01), após o mapeamento objeto-relacional:
'   - identificadores (id) explícitos em todas as entidades
'   - Usuario guarda senhaHash (BCrypt) em vez da senha em texto
'   - EmpresaParceira ganhou telefone; Vantagem ganhou o indicador "ativa"
'   - nova classe SaldoInsuficienteException para as regras de saldo
'
' v2.1 - novo requisito (transferência entre alunos com aprovação):
'   - nova classe TransferenciaMoedas (especialização de Transacao)
'   - nova enumeração StatusTransferencia
'   - RegrasTransferencia guarda os limites configuráveis
' =====================================================================

title Sistema de Moeda Estudantil — Diagrama de Classes do Domínio (v2.1 · Lab03S02)

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam class {
  BackgroundColor #FDFDFD
  BorderColor #444444
  ArrowColor #444444
}
hide empty members
set separator none

abstract class Usuario {
  - id : Long
  - nome : String
  - email : String
  - senhaHash : String
  + {abstract} getTipo() : TipoUsuario
}

enum TipoUsuario {
  ALUNO
  PROFESSOR
  EMPRESA_PARCEIRA
}

class Aluno {
  - cpf : String
  - rg : String
  - curso : String
  - saldoMoedas : int
  + receberMoedas(valor : int) : void
  + debitarMoedas(valor : int) : void
}

class Professor {
  + {static} CREDITO_SEMESTRAL : int = 1000
  - cpf : String
  - departamento : String
  - saldoMoedas : int
  + receberCreditoSemestral() : void
  + debitarEnvio(valor : int) : void
}

class EmpresaParceira {
  - cnpj : String
  - telefone : String
  + adicionarVantagem(v : Vantagem) : void
}

class Endereco <<embeddable>> {
  - logradouro : String
  - numero : String
  - complemento : String
  - bairro : String
  - cidade : String
  - uf : String
  - cep : String
}

class InstituicaoEnsino {
  - id : Long
  - nome : String
  - sigla : String
}

class Vantagem {
  - id : Long
  - titulo : String
  - descricao : String
  - fotoUrl : String
  - custoMoedas : int
  - ativa : boolean
}

abstract class Transacao {
  - id : Long
  - dataHora : LocalDateTime
  - valor : int
  + {abstract} getDescricao() : String
}

class EnvioMoedas {
  - motivo : String
}

class ResgateVantagem {
  - codigoCupom : String
}

class CreditoSemestral {
  - semestre : String
}

class SaldoInsuficienteException <<exception>>

class TransferenciaMoedas {
  - motivo : String
  - status : StatusTransferencia
  - dataDecisao : LocalDateTime
  - justificativa : String
  + aprovar(p : Professor) : void
  + rejeitar(p : Professor, justificativa : String) : void
  + cancelar() : void
  + expirar() : void
  + isPendente() : boolean
}

enum StatusTransferencia {
  PENDENTE
  APROVADA
  REJEITADA
  CANCELADA
  EXPIRADA
}

class RegrasTransferencia <<record>> {
  + valorMaximo : int = 100
  + limiteMensal : int = 300
  + maximoPendentes : int = 3
  + prazoAprovacaoDias : int = 7
  + tamanhoMinimoMotivo : int = 10
}

Transacao <|-- TransferenciaMoedas
TransferenciaMoedas "*" --> "1" Aluno : remetente
TransferenciaMoedas "*" --> "1" Aluno : destinatário
TransferenciaMoedas "*" --> "0..1" Professor : avaliador
TransferenciaMoedas --> StatusTransferencia
TransferenciaMoedas ..> RegrasTransferencia : <<validada por\nTransferenciaService>>

Usuario <|-- Aluno
Usuario <|-- Professor
Usuario <|-- EmpresaParceira
Usuario ..> TipoUsuario

Aluno *-- "1" Endereco
Aluno "*" --> "1" InstituicaoEnsino : estuda em >
Professor "*" --> "1" InstituicaoEnsino : faz parte de >

EmpresaParceira "1" *-- "*" Vantagem : oferece >

Transacao <|-- EnvioMoedas
Transacao <|-- ResgateVantagem
Transacao <|-- CreditoSemestral

EnvioMoedas "*" --> "1" Professor : remetente
EnvioMoedas "*" --> "1" Aluno : destinatário
ResgateVantagem "*" --> "1" Aluno
ResgateVantagem "*" --> "1" Vantagem
CreditoSemestral "*" --> "1" Professor

Aluno ..> SaldoInsuficienteException : <<throws>>
Professor ..> SaldoInsuficienteException : <<throws>>

@enduml
